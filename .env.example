# Variabili d'ambiente di concerti-gabri (solo nomi e commenti, mai valori).
# Branch multiutente: TanStack Start su Vercel + Convex (docs/multiutente/).
# In locale finiscono in .env.local (gitignored). Su t3node lo scrive
# `t3-env-sync` da fnox: si aggiungono con `fnox set NOME`, mai a mano.
# Mappa completa di dove vive ogni variabile: docs/multiutente/DECISIONI.md.

# ── App (locale + Vercel Production/Preview) ──────────────────────────────
# URL pubblico dell'app in sviluppo (base di Better Auth e dei link assoluti).
# Su t3node: l'URL tailnet della porta 3100. Sulle preview/produzione lo
# ricava il codice dall'ambiente Vercel.
VITE_SITE_URL=
# Token pubblico Mapbox (pk.) per la mappa, limitato per URL in
# console.mapbox.com (Mapbox controlla il Referer). Nessun token Mapbox server:
# il geocoding usa OpenStreetMap (Nominatim), vedi DECISIONI.md.
VITE_MAPBOX_TOKEN=
# Oracolo (route server di Start): chiave Google AI Studio, solo lato server.
GEMINI_API_KEY=
# Facoltativo, default gemini-3.1-flash-lite (la famiglia gemini-2.5 è deprecata).
GEMINI_MODEL=
# Sentry (org gabriele-filaferro, regione EU). Il DSN è pubblico.
VITE_SENTRY_DSN=
# Organization Token Sentry: serve solo al build per caricare le source map.
SENTRY_AUTH_TOKEN=
# PostHog EU, senza cookie, via reverse proxy /ingest: Project API key (phc_, pubblica).
VITE_POSTHOG_KEY=

# ── Convex ────────────────────────────────────────────────────────────────
# Deployment di sviluppo: li scrive `npx convex dev` (non sono segreti).
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Stesso host di VITE_CONVEX_URL ma .convex.site: lì girano le HTTP action (Better Auth).
VITE_CONVEX_SITE_URL=
# Solo nei build Vercel, mai in locale (farebbe puntare `npx convex` alla produzione):
# Production = deploy key del deployment prod, Preview = preview deploy key del progetto.
# Il build (vercel.json) lancia `convex deploy`, che imposta VITE_CONVEX_URL e
# VITE_CONVEX_SITE_URL da solo.
# CONVEX_DEPLOY_KEY=
# Solo su Vercel (Production + Preview): usa il pnpm di `packageManager` via Corepack.
# ENABLE_EXPERIMENTAL_COREPACK=1
# Solo in locale, per gli smoke test sulle preview protette (header
# x-vercel-protection-bypass). Nei deploy Vercel esiste già come variabile di sistema.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Env di Convex ─────────────────────────────────────────────────────────
# Si impostano con `npx convex env set [--prod]` e, per le preview, con
# `npx convex env default set --type preview`. NON vanno in .env.local:
# Better Auth gira dentro Convex e le legge lì. Qui solo per documentarle.
# Segreto di Better Auth, uno diverso per dev / preview / prod (openssl rand -base64 32).
# BETTER_AUTH_SECRET=
# baseURL di Better Auth: URL pubblico dell'app per quel deployment.
# SITE_URL=
# Origini fidate, separate da virgola, URL esatti (niente jolly su *.vercel.app).
# BETTER_AUTH_TRUSTED_ORIGINS=
# Client OAuth Web di Google (Google Auth Platform → Clients), uno per tutti gli ambienti.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email OTP (facoltativa, vedi DECISIONI.md): senza queste due il login in
# produzione è solo Google. API key Resend con solo permesso di invio, limitata
# al dominio del mittente; mittente su un dominio verificato in Resend (EU).
# RESEND_API_KEY=
# EMAIL_FROM=Concerti <notifications@concerti.gabrifila.me>
# Geocoder OpenStreetMap (facoltativo, default https://nominatim.openstreetmap.org).
# NOMINATIM_URL=

# ── Migrazione dello storico chat (solo in locale, al momento dello switch) ─
# Upstash Redis del sito attuale (chiavi concerti:chat:log:*). Il token ha
# permessi di SCRITTURA (scelta di Gabri, DECISIONI.md): lo script usa solo
# comandi di lettura e non va mai messo su Vercel o Convex.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN_RW=

# ── Sito attuale (Netlify, in pausa fino allo switch) ─────────────────────
# Le funzioni netlify/functions/* usano ancora queste; spariscono con la Fase 3.
# Upstash con token di scrittura (rate limit + log delle chat):
# UPSTASH_REDIS_REST_TOKEN=
# Limiti della chat: richieste/minuto/IP, richieste/giorno/IP, richieste/giorno totali
# (default 8 / 40 / 200) e durata dei log in giorni (default 90).
# CHAT_RPM_PER_IP=
# CHAT_RPD_PER_IP=
# CHAT_RPD_GLOBAL=
# CHAT_LOG_TTL_DAYS=

# ── Test locali (traguardo 1). Solo locale: MAI su Vercel né su Convex. ──
# Abilita gli override di test lato server (solo locale, fuori da Vercel).
E2E=
# Istante congelato del server in ISO 8601, letto solo con E2E=1 e fuori da Vercel (solo locale), es. 2026-10-21T12:00:00+02:00
E2E_NOW=
# Build e2e del client, es. PostHog senza compressione dal traguardo 8 (solo locale).
VITE_E2E=
