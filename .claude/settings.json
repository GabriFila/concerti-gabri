{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*convex deploy*)",
      "Bash(*convex*--prod*)",
      "Bash(*convex*--deployment prod*)",
      "Bash(*convex*--deployment=prod*)",
      "Bash(*convex*:production*)",
      "Bash(*convex*--type prod*)",
      "Bash(*brave-chickadee*)",
      "Bash(*fnox*-P prod*)",
      "Bash(*fnox*--profile prod*)",
      "Bash(*FNOX_PROFILE=prod*)",
      "Bash(*vercel --prod*)",
      "Bash(*vercel deploy*)",
      "Bash(*vercel promote*)",
      "Bash(*vercel rollback*)",
      "Bash(*git push*origin main*)",
      "Bash(*git push*:main*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f*)",
      "Bash(*pgrep -a*)",
      "Bash(*pgrep -fa*)",
      "Bash(*pgrep -af*)",
      "Bash(*pgrep -l*)",
      "Bash(*ps aux*)",
      "Bash(*ps -ef*)",
      "Bash(*ps -f*)",
      "Bash(*ps -e*)",
      "Bash(*ps -A*)",
      "Bash(*ps ax*)",
      "Bash(*ps -o*)",
      "Bash(*ps -p*)",
      "Bash(*/proc/*/cmdline*)",
      "Bash(*/proc/*/environ*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env | *)",
      "Bash(export -p*)",
      "Bash(declare -x*)",
      "Bash(declare -p*)",
      "Bash(set)",
      "Bash(set | *)"
    ]
  }
}
